# Copier en .env et adapter
DATABASE_URL=postgresql+psycopg2://dawn_user:dawn_password@localhost:5432/dawn_db
SECRET_KEY=change-moi-en-production-avec-une-valeur-aleatoire-longue
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# RAG — Ollama et embeddings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=16000

# Modèle ECG (voir README, section « Modèle ECG »)
ECG_MODEL_PATH=models/dawn_ecg_model_final.pt
ECG_HUBERT_DIR=models/hubert-ecg-small
ECG_MODELES=all
ECG_DEVICE=cpu
ECG_PRECHARGER=true
ECG_AGE_MAX_ANS=18
# Récupération automatique du modèle depuis le dépôt Hugging Face PRIVÉ (téléchargé au 1er démarrage, ~730 Mo)
# Jeton « fine-grained » en LECTURE SEULE limité à ce dépôt. Ce fichier .env n'est jamais versionné.
HF_TOKEN=
ECG_AUTO_DOWNLOAD=true
ECG_HF_REPO=adama9900/dawn-ecg-pediatrique
ECG_HF_FILENAME=dawn_ecg_model_final.pt
ECG_HF_CALIBRATION_FILENAME=calibration_artifacts.json   # calibration/seuils/conforme : lue dans le même dépôt (sinon copie livrée)
# ECG_HF_REVISION=<hash de commit>   # figer la version du modèle (reproductibilité)

# Mesure automatique du temps de réponse (logs/temps_reponses.csv, résumé : python scripts/resume_temps.py)
TEMPS_LOG_ACTIF=true
